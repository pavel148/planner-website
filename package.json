{
  "name": "mythos-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/security.test.mjs",
    "typecheck": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types && tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "cf:login": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler login",
    "cf:whoami": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler whoami",
    "cf:setup": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log node scripts/setup-cloudflare.mjs",
    "db:migrate:local": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrate:remote && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "^4.138.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.4"
  }
}
