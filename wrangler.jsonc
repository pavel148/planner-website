{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mythos-planner",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mythos-db",
      "database_id": "2476dd30-51b1-4327-bd1b-c697125f1e9c",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mythos-media"
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
